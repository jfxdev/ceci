PORT=8110
DATABASE_URL=postgres://leaflag:leaflag@localhost:5433/leaflag?sslmode=disable
JWT_SECRET=dev-secret-change-me

# all-in-one is the local/POC default. Production deploys the same image as
# separate control-plane and data-plane services.
LEAFLAG_MODE=all-in-one
EDGE_SYNC_INTERVAL=5s

# Required by control-plane mode. A comma-separated list allows zero-downtime
# rotation; data-plane mode uses one of these values as RUNTIME_SYNC_TOKEN.
# RUNTIME_SYNC_TOKENS=replace-with-a-long-random-secret
# CONTROL_PLANE_URL=https://control.example.com
# RUNTIME_SYNC_TOKEN=replace-with-a-long-random-secret

# Master key for all application secrets persisted in PostgreSQL, including
# OIDC client secrets and future encrypted parameter values. Use a distinct
# high-entropy secret in production. Do not rotate it without a re-encryption
# migration. OIDC itself is configured from Administration > Access groups.
# ENCRYPTION_KEY=replace-with-a-long-random-secret
